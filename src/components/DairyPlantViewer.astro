<div class="dairy-viewer" data-dairy-viewer>

  <div class="dairy-viewer__stage">

    <!-- Permanent fallback/initial image -->
    <img
      class="dairy-viewer__overview"
      src="/images/dairy/dairy-overview.webp"
      alt="Overview of the interactive dairy processing plant"
    />

    <!-- Persistent master video -->
    <video
      class="dairy-viewer__video"
      data-master-video
      muted
      playsinline
      preload="metadata"
    >
      <source
        src="/videos/dairy.webm"
        type="video/webm"
      />

      <source
        src="/videos/dairy-master.mp4"
        type="video/mp4"
      />
    </video>


    <!-- POIs -->
    <div class="dairy-viewer__pois" data-pois>

    <button
      class="dairy-poi"
