      <span>18</span>
    </button>
    </div>


    <!-- Zone UI -->
    <div
      class="dairy-viewer__zone-ui"
      data-zone-ui
      hidden
    >
      <button
        class="dairy-viewer__back"
        data-back
        type="button"
      >
        ← Back to plant
      </button>

      <div class="dairy-viewer__zone-label">
        <span data-zone-number></span>
        <strong data-zone-title></strong>
      </div>
    </div>


    <!-- Loading indicator -->
    <div
      class="dairy-viewer__loading"
      data-loading
      hidden
    >
      Loading view…
    </div>

  </div>


  <div class="dairy-viewer__instructions">
    <p>
      Select a point of interest to explore the plant.
    </p>
  </div>

</div>


<script>
  const FPS = 25;

  const FIRST_FRAME = 12;
  const CYCLE_FRAMES = 125;

  // Zoom-in + destination hold
  const OPEN_FRAMES = 63;

  /*
   * "number" = number displayed on the plant
   * "timelineIndex" = position in the rendered master video
   */
  const zoneData = [
    {
      id: 'cow-farm',
      label: 'Cow Farm',
      number: '01',
      timelineIndex: 0,
    },
    {
      id: 'control-room',
      label: 'Control Room',
      number: '02',
      timelineIndex: 13,
    },
    {
      id: 'milk-reception',
      label: 'Milk Reception',
      number: '03',
      timelineIndex: 11,
    },
    {
      id: 'rmst',
      label: 'RMST',
      number: '04',
      timelineIndex: 10,
    },
    {
      id: 'pasteuriser',
      label: 'Pasteuriser',
      number: '05',
      timelineIndex: 6,
    },
    {
      id: 'pmst',
      label: 'PMST',
      number: '06',
      timelineIndex: 7,
    },
    {
      id: 'butter-tank',
      label: 'Butter Tank',
      number: '07',
      timelineIndex: 4,
    },
    {
      id: 'yogurt-tank',
      label: 'Yogurt Tank',
      number: '08',
      timelineIndex: 16,
    },
    {
      id: 'cip',
      label: 'CIP',
      number: '09',
      timelineIndex: 5,
    },
    {
      id: 'packaging',
      label: 'Packaging',
      number: '10',
      timelineIndex: 15,
    },
    {
      id: 'warehouse',
      label: 'Warehouse',
      number: '11',
      timelineIndex: 3,
    },
    {
      id: 'lab',
      label: 'Lab',
      number: '12',
      timelineIndex: 14,
    },
    {
      id: 'shipping',
      label: 'Shipping',
      number: '13',
      timelineIndex: 2,
    },
    {
      id: 'office',
      label: 'Office',
      number: '14',
      timelineIndex: 12,
    },
    {
      id: 'chiller',
      label: 'Chiller',
      number: '15',
      timelineIndex: 8,
    },
    {
      id: 'www',
      label: 'WWW',
      number: '16',
      timelineIndex: 1,
    },
    {
      id: 'grid',
      label: 'Grid',
      number: '17',
      timelineIndex: 9,
    },
    {
      id: 'ev-charging',
      label: 'EV Charging',
      number: '18',
      timelineIndex: 17,
    },
  ].map((zone) => {
    const inStart =
      FIRST_FRAME + (zone.timelineIndex * CYCLE_FRAMES);

    const inEnd =
      inStart + OPEN_FRAMES;

    return {
      ...zone,
      inStart,
      inEnd,
      outStart: inEnd,
      outEnd: inStart + CYCLE_FRAMES,
    };
  });


  const frameToSeconds = (frame) =>
    frame / FPS;


  document
    .querySelectorAll('[data-dairy-viewer]')
    .forEach((viewer) => {

      const video =
        viewer.querySelector('[data-master-video]');

      const pois =
        viewer.querySelector('[data-pois]');

      const zoneUI =
        viewer.querySelector('[data-zone-ui]');

      const backButton =
        viewer.querySelector('[data-back]');

      const title =
        viewer.querySelector('[data-zone-title]');

      const number =
        viewer.querySelector('[data-zone-number]');

      const loading =
        viewer.querySelector('[data-loading]');


      if (
        !video ||
        !pois ||
        !zoneUI ||
        !backButton ||
        !title ||
        !number ||
        !loading
      ) {
        return;
      }


      let activeZone = null;
      let playing = false;


      function setLoading(value) {
        loading.hidden = !value;
      }


      function setPOIsVisible(value) {
        pois.classList.toggle(
          'is-hidden',
          !value
        );
      }


      function showZoneUI(zone) {
        title.textContent = zone.label;
        number.textContent = zone.number;

        zoneUI.hidden = false;
      }


      function hideZoneUI() {
        zoneUI.hidden = true;
      }


      function waitForSeek(videoElement) {
        return new Promise((resolve) => {

          if (!videoElement.seeking) {
            resolve();
            return;
          }

          videoElement.addEventListener(
            'seeked',
            resolve,
            { once: true }
          );

        });
      }


      async function playSegment(
        startFrame,
        endFrame,
        shouldSeek = true
      ) {
        if (playing) return;

        playing = true;
        setLoading(true);

        const start = frameToSeconds(startFrame);
        const end = frameToSeconds(endFrame);

        /*
        * Only seek when opening a new POI.
        *
        * When returning to the overview, the video is
        * already paused at the correct position, so
        * seeking again would cause visible decoding jumps
        * when the file is streamed over the network.
        */
        if (shouldSeek) {
          video.currentTime = start;

          await waitForSeek(video);
        }

        video.classList.add('is-visible');

        setLoading(false);

        try {
          await video.play();
        } catch (error) {
          console.error(
            'Unable to play dairy master video:',
            error
          );

          playing = false;
          return;
        }

        return new Promise((resolve) => {

          const monitor = () => {

            if (video.currentTime >= end) {

              /*
              * IMPORTANT:
              * Just pause.
              *
              * Do NOT set video.currentTime = end here.
              * Doing so creates another network seek.
              */
              video.pause();

              playing = false;

              resolve();
              return;
            }

            requestAnimationFrame(monitor);
          };

          requestAnimationFrame(monitor);

        });
      }

      viewer
        .querySelectorAll('[data-zone]')
        .forEach((button) => {

          button.addEventListener(
            'click',
            async () => {

              if (playing) return;

              const zoneId =
                button.dataset.zone;

              const zone =
                zoneData.find(
                  (item) => item.id === zoneId
                );

              if (!zone) return;

              activeZone = zone;

              setPOIsVisible(false);
              hideZoneUI();

              await playSegment(
                zone.inStart,
                zone.inEnd
              );

              showZoneUI(zone);
            }
          );

        });


      backButton.addEventListener(
        'click',
        async () => {

          if (
            !activeZone ||
            playing
          ) {
            return;
          }

          const zone = activeZone;

          hideZoneUI();

          /*
          * Continue directly from the paused
          * zoomed-in frame. No seek.
          */
          await playSegment(
            zone.outStart,
            zone.outEnd,
            false
          );

          activeZone = null;

          setPOIsVisible(true);
        }
      );

      const beginPreload = () => {
        video.preload = 'auto';
        video.load();
      };


      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(
          beginPreload,
          { timeout: 1800 }
        );
      } else {
        window.setTimeout(
          beginPreload,
          800
        );
      }

    });
</script>