---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/about.css';
---
<BaseLayout
  title="About | Ipsita CRTX"
  description="Ipsita Bose is an engineer, multimedia designer and content strategist working across technology, 3D, motion, interactive experiences and visual storytelling."
>
  <Header active="about" />

  <main class="about-page">

    <!-- HERO -->
    <section class="about-hero shell">

      <div class="about-hero__copy">
        <p class="eyebrow">About</p>

        <h1 class="display">
          I work between
          <span>systems & stories.</span>
        </h1>

        <p class="about-intro">
          I work across engineering, perception systems, interactive visualization,
          3D web development, UX/UI, motion and technical storytelling.
        </p>

        <p class="about-intro about-intro--secondary">
          My work sits at the intersection of technical understanding and
          creative communication — from immersive demos to eye-catching
          campaigns and content strategy.
        </p>
      </div>

      <figure class="about-portrait">
        <img
          src="/images/about/portrait.png"
          alt="Portrait of Ipsita Bose"
        />
      </figure>

    </section>


    <!-- THREE DISCIPLINES -->
    <section class="about-section shell">

      <div class="about-section__heading">
        <p class="eyebrow">How I work</p>

        <h2 class="display">
          Three disciplines.
          <span>One practice.</span>
        </h2>
      </div>

      <div class="practice-grid">

        <article class="practice-card">
          <span>01</span>

          <h3 class="display">Engineering</h3>

          <p>
            I begin by understanding how a system works — its mechanics,
            constraints, dependencies and technical context.
          </p>
        </article>

        <article class="practice-card">
          <span>02</span>

          <h3 class="display">Design</h3>

          <p>
            I translate that understanding into visual, spatial, and interactive
            experiences that make complex ideas easier to engage with.
          </p>
        </article>

        <article class="practice-card">
          <span>03</span>

          <h3 class="display">Content Strategy</h3>

          <p>
            I design what needs to be communicated, who needs to understand
            it, and which format can tell that story most effectively.
          </p>
        </article>

      </div>

    </section>


    <!-- CREATRIX -->
    <section class="about-section shell creatrix-section">

      <div class="creatrix-mark">
        <img
          src="/images/ipsita-logo.svg"
          alt="Ipsita CRTX"
        />
      </div>

      <div class="creatrix-copy">
        <p class="eyebrow">The name behind CRTX</p>

        <h2 class="display">
          Why
          <span>Creatrix?</span>
        </h2>

        <p>
          Creatrix means a woman who creates — a maker, originator or creative
          force. I use it because my work rarely belongs to a single discipline.
        </p>

        <p>
          I move between engineering, design, 3D, motion, strategy and physical
          prototyping, and CRTX became a way to bring those practices together under
          one identity.
        </p>

        <p>
          It is less a job title than a way of working: understanding, making
          and shaping how an idea is experienced.
        </p>
      </div>

    </section>


    <!-- BACKGROUND / EDUCATION -->
    <section class="about-section shell split-about">

      <div>
        <p class="eyebrow">Background</p>

        <h2 class="display">
          Built from
          <span>two worlds.</span>
        </h2>
      </div>

      <div class="about-copy">

        <p>
          I studied engineering at <strong>Ramaiah Institute of Technology</strong>, which
          gave me the technical foundation that still shapes how I approach
          design, visualization and communication.
        </p>

        <p>
          Over time, my work moved increasingly toward the point where
          technology meets people — translating technical systems into content
          and experiences that are easier to understand, navigate and believe in.
        </p>

        <p>
          That progression has taken me across industrial technology,
          multimedia design, 3D visualization, motion, interactive experiences
          and content strategy.
        </p>

      </div>

    </section>


    <!-- EXPERIENCE -->
    <section class="about-section shell experience-section">

      <div class="about-section__heading">
        <p class="eyebrow">Experience</p>

        <h2 class="display">
          Across technology,
          <span>media & communication.</span>
        </h2>

        <p class="experience-intro">
          I’ve worked across industrial technology, media and creative
          communication environments.
        </p>
      </div>

      <div class="experience-logos">

        <div class="experience-logo">
          <img
            src="/images/about/schneider.webp"
            alt="Schneider Electric"
          />
        </div>

        <div class="experience-logo">
          <img
            src="/images/about/onnes.webp"
            alt="Onnes Cryogenics"
          />
        </div>

        <div class="experience-logo">
          <img
            src="/images/about/depicc.webp"
            alt="DEPICC"
          />
        </div>

        <div class="experience-logo">
          <img
            src="/images/about/raveolution.webp"
            alt="Raveolution Studios"
          />
        </div>

          <div class="experience-logo">
          <img
            src="/images/about/tspms.webp"
            alt="The Six PM Show"
          />
        </div>

      </div>

    </section>


    <!-- BEYOND THE SCREEN -->
    <section class="about-section shell split-about beyond-section">

      <div>
        <p class="eyebrow">Beyond Corporate</p>

        <h2 class="display">
          Making is part of
          <span>how I think.</span>
        </h2>
      </div>

      <div class="about-copy">

        <p>
          Outside digital work, I practice handpoke tattooing and experiment
          with physical prototyping.
        </p>

        <p>
          Tattooing has shaped the way I think about form, symbolism,
          materiality and the relationship between an object, an experience
          and the person interacting with it.
        </p>

      </div>
    </section>

  </main>
</BaseLayout>