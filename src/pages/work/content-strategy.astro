---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

import '../../styles/content-strategy.css';
---

<BaseLayout
  title="Content Strategy | Ipsita Bose"
  description="Campaigns, editorial systems, event communication and recurring content designed around audience, message and channel."
>
  <Header active="work" />

  <main class="content-strategy-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="cs-hero shell">

      <p class="eyebrow">
        Audience / Message / Channel
      </p>

      <h1 class="display">
        Content<br />
        <span>Strategy.</span>
      </h1>

      <p class="cs-hero__intro">
        Campaigns, editorial systems, event communication, and recurring
        content designed around audience, message, and channel.
      </p>

      <div class="cs-capabilities">
        <span>Campaign Planning</span>
        <span>Content Mapping</span>
        <span>Audience Communication</span>
        <span>Editorial Systems</span>
        <span>Narrative Development</span>
      </div>

    </section>


    <!-- =====================================================
         CONTENT STRATEGY INDEX
    ====================================================== -->

    <section class="cs-index shell">

      <div class="section-heading">
        <p class="eyebrow">Selected work</p>

        <div class="section-rule">
          <span>⌁</span>
        </div>
      </div>


      <div class="cs-card-grid">

        <!-- 01 WEBINARS -->

        <a
          class="cs-card cs-card--large"
          href="/work/webinar-communication"
        >

          <div class="cs-card__visual">
            <div class="cs-placeholder">
              <span>Webinar Communication Visual</span>
            </div>
          </div>

          <div class="cs-card__content">

            <span class="cs-card__number">
              01
            </span>

            <div class="cs-card__body">

              <p class="cs-card__type">
                Multi-channel technical campaigns
              </p>

              <h2 class="display">
                Webinar<br />
                Communication
              </h2>

              <p class="cs-card__description">
                Technical subjects translated into coordinated campaign
                communication across promotional, editorial and event
                touchpoints.
              </p>

              <div class="cs-card__tags">
                <span>Campaign Planning</span>
                <span>Content Mapping</span>
                <span>Technical Communication</span>
                <span>Multi-channel Content</span>
              </div>

              <p class="cs-card__link">
                View case study →
              </p>

            </div>

          </div>

        </a>


        <!-- 02 SOLUTION CONSULTANT WEEK -->

        <a
          class="cs-card cs-card--large"
          href="/work/solution-consultant-week"
        >

          <div class="cs-card__visual">
            <div class="cs-placeholder">
              <span>Solution Consultant Week Visual</span>
            </div>
          </div>

          <div class="cs-card__content">

            <span class="cs-card__number">
              02
            </span>

            <div class="cs-card__body">

              <p class="cs-card__type">
                Event communication
              </p>

              <h2 class="display">
                Solution<br />
                Consultant Week
              </h2>

              <p class="cs-card__description">
                Communication structured around the event lifecycle,
                from awareness and anticipation through participation
                and follow-up.
              </p>

              <div class="cs-card__tags">
                <span>Event Communication</span>
                <span>Campaign Sequencing</span>
                <span>Audience Engagement</span>
              </div>

              <p class="cs-card__link">
                View case study →
              </p>

            </div>

          </div>

        </a>


        <!-- 03 NEWSLETTER -->

        <a
          class="cs-card cs-card--wide"
          href="/work/monthly-newsletter"
        >

          <div class="cs-card__visual">
            <div class="cs-placeholder">
              <span>Monthly Newsletter Visual</span>
            </div>
          </div>

          <div class="cs-card__content">

            <span class="cs-card__number">
              03
            </span>

            <div class="cs-card__body">

              <p class="cs-card__type">
                Editorial system
              </p>

              <h2 class="display">
                Monthly<br />
                Newsletter
              </h2>

              <p class="cs-card__description">
                A recurring editorial system built around content
                selection, information hierarchy and consistent
                audience communication.
              </p>

              <div class="cs-card__tags">
                <span>Editorial Strategy</span>
                <span>Content Selection</span>
                <span>Information Hierarchy</span>
                <span>Recurring Content</span>
              </div>

              <p class="cs-card__link">
                View editorial system →
              </p>

            </div>

          </div>

        </a>


        <!-- 04 YEAR END -->

        <a
          class="cs-card cs-card--small"
          href="#year-end"
        >

          <div class="cs-card__visual">
            <div class="cs-placeholder">
              <span>Year-End Visual</span>
            </div>
          </div>

          <div class="cs-card__content">

            <span class="cs-card__number">
              04
            </span>

            <div class="cs-card__body">

              <p class="cs-card__type">
                Organisational storytelling
              </p>

              <h2 class="display">
                Year-End<br />
                Communication
              </h2>

              <p class="cs-card__description">
                Annual activity shaped into concise recap narratives
                and closing communication.
              </p>

              <div class="cs-card__tags">
                <span>Narrative Development</span>
                <span>Video</span>
                <span>Internal Communication</span>
              </div>

              <p class="cs-card__link">
                Explore work ↓
              </p>

            </div>

          </div>

        </a>


        <!-- 05 SELECTED -->

        <a
          class="cs-card cs-card--small"
          href="#selected-communications"
        >

          <div class="cs-card__visual">
            <div class="cs-placeholder">
              <span>Selected Communications Visual</span>
            </div>
          </div>

          <div class="cs-card__content">

            <span class="cs-card__number">
              05
            </span>

            <div class="cs-card__body">

              <p class="cs-card__type">
                Selected communication
              </p>

              <h2 class="display">
                Selected<br />
                Communications
              </h2>

              <p class="cs-card__description">
                Standalone communication created across campaigns,
                employee initiatives, events and internal audiences.
              </p>

              <div class="cs-card__tags">
                <span>Campaigns</span>
                <span>Social</span>
                <span>Internal Communication</span>
              </div>

              <p class="cs-card__link">
                Explore archive ↓
              </p>

            </div>

          </div>

        </a>

      </div>

    </section>


    <!-- =====================================================
         04 YEAR-END COMMUNICATION
    ====================================================== -->

    <section
      class="cs-detail shell"
      id="year-end"
    >

      <div class="section-heading">
        <p class="eyebrow">
          04 / Year-End Communication
        </p>

        <div class="section-rule"></div>
      </div>


      <div class="cs-detail__intro">

        <div>

          <p class="cs-kicker">
            Organisational storytelling
          </p>

          <h2 class="display">
            A year of activity.<br />
            <span>One closing story.</span>
          </h2>

        </div>


        <p>
          Year-end communication required selecting meaningful moments
          from a wider body of activity and shaping them into concise
          narratives for internal audiences.
        </p>

      </div>


      <div class="cs-year-end-grid">

        <article>

          <div class="cs-placeholder cs-placeholder--video">
            <span>Year-End Video 01</span>
          </div>

          <p>
            Year-End Communication
          </p>

          <span>
            Narrative Development / Video
          </span>

        </article>


        <article>

          <div class="cs-placeholder cs-placeholder--video">
            <span>Year-End Video 02</span>
          </div>

          <p>
            Year-End Communication
          </p>

          <span>
            Organisational Storytelling / Video
          </span>

        </article>

      </div>

    </section>


    <!-- =====================================================
         05 SELECTED COMMUNICATIONS
    ====================================================== -->

    <section
      class="cs-detail shell"
      id="selected-communications"
    >

      <div class="section-heading">

        <p class="eyebrow">
          05 / Selected Communications
        </p>

        <div class="section-rule"></div>

      </div>


      <div class="cs-detail__intro">

        <div>

          <p class="cs-kicker">
            Campaign fragments & one-off communication
          </p>

          <h2 class="display">
            Different contexts.<br />
            <span>Focused communication.</span>
          </h2>

        </div>


        <p>
          A selection of standalone work created for campaigns,
          employee initiatives, events and internal audiences.
        </p>

      </div>


      <div class="cs-archive">

        <article>

          <div class="cs-placeholder">
            <span>Communication Visual</span>
          </div>

          <p>
            People with Disabilities ERN
          </p>

          <span>
            Internal Communication
          </span>

        </article>


        <article>

          <div class="cs-placeholder">
            <span>Communication Visual</span>
          </div>

          <p>
            Communication Title
          </p>

          <span>
            Campaign / Social
          </span>

        </article>


        <article>

          <div class="cs-placeholder">
            <span>Communication Visual</span>
          </div>

          <p>
            Communication Title
          </p>

          <span>
            Event Communication
          </span>

        </article>

      </div>

    </section>


    <!-- =====================================================
         NEXT
    ====================================================== -->

    <section class="cs-next shell">

      <p class="eyebrow">
        Next
      </p>

      <a href="/work/technical-storytelling">

        <div>

          <span>
            02
          </span>

          <h2 class="display">
            Technical<br />
            <strong>Storytelling.</strong>
          </h2>

        </div>

        <i aria-hidden="true">
          ↗
        </i>

      </a>

    </section>

  </main>

</BaseLayout>