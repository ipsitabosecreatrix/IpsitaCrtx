---

<BaseLayout
  title="Resume | Ipsita Bose"
  description="Resume of Ipsita Bose — Perception Engineer and Multimedia Designer working across engineering, interactive technology, visual design and technical storytelling."
>
  <Header active="resume" />

  <main class="resume-page">

    <!-- =========================
         HERO
    ========================== -->

    <section class="resume-hero shell">

      <div class="resume-hero__copy">

        <p class="eyebrow">Resume</p>

        <h1 class="display">
          Engineering.<br />
          Design.<br />
          <span>Perception.</span>
        </h1>

        <p class="resume-hero__intro">
          Perception Engineer and Multimedia Designer with an Electronics
          Engineering background, working across machine vision, industrial
          automation, engineering simulation, interactive 3D, UX/UI, visual
          communication, motion, technical storytelling, content strategy,
          and voice performance.
        </p>

        <a
          class="button"
          href="/documents/Ipsita-Bose-Resume.pdf"
          download
        >
          Download Full Resume
          <span>↓</span>
        </a>

        <p class="resume-hero__download-note">
          Complete experience, capability and project record.
        </p>

      </div>


      <nav
        class="resume-hero__index"
        aria-label="Resume sections"
      >
        <a href="#experience">
          <span>01</span>
          <strong>Experience</strong>
          <i>↓</i>
        </a>

        <a href="#capabilities">
          <span>02</span>
          <strong>Core Capabilities</strong>
          <i>↓</i>
        </a>

        <a href="#projects">
          <span>03</span>
          <strong>Selected Projects</strong>
          <i>↓</i>
        </a>

        <a href="#education">
          <span>04</span>
          <strong>Engineering Background</strong>
          <i>↓</i>
        </a>
      </nav>

    </section>



    <!-- =========================
         EXPERIENCE
    ========================== -->

    <section
      class="resume-section shell"
      id="experience"
    >

      <div class="section-heading">
        <p class="eyebrow">01 / Experience</p>
        <div class="section-rule"></div>
      </div>


      <div class="experience-list">

        {
          experience.map((item) => (

            <article class="resume-entry">

              <div class="resume-entry__meta">
                <p>{item.company}</p>
                <span>{item.date}</span>
              </div>


              <div class="resume-entry__content">

                <h2>{item.role}</h2>

                <p class="resume-entry__company">
                  {item.company}
                </p>

                <p class="resume-entry__description">
                  {item.description}
                </p>


                {
                  item.areas && (
                    <div class="resume-tags">
                      {
                        item.areas.map((area) => (
                          <span>{area}</span>
                        ))
                      }
                    </div>
                  )
                }

              </div>

            </article>

          ))
        }

      </div>

    </section>



    <!-- =========================
         CORE CAPABILITIES
    ========================== -->

    <section
      class="resume-section shell"
      id="capabilities"
    >

      <div class="section-heading">
        <p class="eyebrow">02 / Core Capabilities</p>
        <div class="section-rule"></div>
      </div>


      <div class="capability-list">

        {
          capabilities.map((capability) => (

            <article class="capability-row">

              <span class="capability-row__number">
                {capability.number}
              </span>


              <h2>
                {capability.title}
              </h2>


              <div class="capability-row__skills">

                {
                  capability.skills.map((skill) => (
                    <span>{skill}</span>
                  ))
                }

              </div>

            </article>

          ))
        }

      </div>

    </section>



    <!-- =========================
         SELECTED PROJECTS
    ========================== -->

    <section
      class="resume-section shell"
      id="projects"
    >

      <div class="section-heading">
        <p class="eyebrow">03 / Selected Projects</p>
        <div class="section-rule"></div>
      </div>


      <div class="resume-project-list">

        {
          projects.map((project, index) => (

            <article class="resume-project">

              <span class="resume-project__number">
                {String(index + 1).padStart(2, '0')}
              </span>


              <div class="resume-project__content">

                <p class="resume-project__discipline">
                  {project.discipline}
                </p>

                <h2>
                  {project.title}
                </h2>

                <p class="resume-project__description">
                  {project.description}
                </p>

              </div>

            </article>

          ))
        }

      </div>


      <p class="resume-project-note">
        The complete project inventory is available in the downloadable resume.
      </p>

    </section>



    <!-- =========================
         ENGINEERING BACKGROUND
    ========================== -->

    <section
      class="resume-section shell"
      id="education"
    >

      <div class="section-heading">
        <p class="eyebrow">04 / Engineering Background</p>
        <div class="section-rule"></div>
      </div>


      <div class="resume-education">

        <span class="resume-education__year">
          2024
        </span>

        <div>
          <h2>
            Bachelor of Engineering
          </h2>

          <p>
            Electronics Engineering
          </p>

          <span>
            Graduated 2024
          </span>
        </div>

      </div>

    </section>



    <!-- =========================
         DOWNLOAD CTA
    ========================== -->

    <section class="resume-download shell">

      <p class="eyebrow">
        Complete Resume
      </p>

      <h2 class="display">
        Seven pages.<br />
        <span>No shortcuts.</span>
      </h2>

      <p class="resume-download__copy">
        The web version is designed for exploration. The downloadable resume
        contains the complete capability map, experience history and project
        inventory.
      </p>

      <a
        class="button"
        href="/documents/Ipsita-Bose-Resume.pdf"
        download
      >
        Download Full Resume
        <span>↓</span>
      </a>

    </section>

  </main>

</BaseLayout>