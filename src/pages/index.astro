---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MedusaCard from '../components/MedusaCard.astro';
import '../styles/work.css';
---
<BaseLayout title="Ipsita Bose | CRTX"  description="Perception Engineer & Multimedia Designer.">
  <Header active="work" />

  <main>
    <section class="hero shell">
      <div class="hero__copy">
        <p class="eyebrow">Hello, I'm Ipsita</p>
        <h1 class="display">I turn complexity into <span>clarity.</span> </h1>
        <p class="hero__discipline">Perception Engineer <i>/</i> Multimedia Designer</p>
        <a class="button" href="#work">My Approach<span>→</span></a>
      </div>

      <div class="hero__visual" aria-label="Animated 3D avatar of Ipsita Bose">
        <video
          class="hero__avatar hero__avatar--desktop"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/videos/avatar-desktop.webm" type="video/webm" />
        </video>

        <video
          class="hero__avatar hero__avatar--mobile"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/videos/avatar-mobile.webm" type="video/webm" />
        </video>
      </div>
    </section>

    <section class="selected shell" id="work">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <div class="section-rule"><span>⌁</span></div>
      </div>

      <div class="featured-grid">
        <MedusaCard />

        <article class="project-card placeholder-card">
          <div class="placeholder-art spray"></div>
          <div class="project-card__meta">
            <span class="project-index">02</span>
            <div><h3 class="display">Spray Dryer</h3><p>3D / Industrial Visualization</p></div>
          </div>
        </article>

        <article class="project-card placeholder-card">
          <div class="placeholder-art dairy"></div>
          <div class="project-card__meta">
            <span class="project-index">03</span>
            <div><h3 class="display">Dairy Visualizer</h3><p>3D / Interactive Experience</p></div>
          </div>
        </article>

        <article class="project-card placeholder-card">
          <div class="placeholder-art globe"></div>
          <div class="project-card__meta">
            <span class="project-index">04</span>
            <div><h3 class="display">3D Globe</h3><p>Creative Development / Web</p></div>
          </div>
        </article>
      </div>
    </section>

    <section class="collections shell">
      <a href="#" class="collection-card"><span>05</span><strong>Motion & Video</strong><em>→</em></a>
      <a href="#" class="collection-card"><span>06</span><strong>Campaigns & Social</strong><em>→</em></a>
      <a href="#" class="collection-card"><span>07</span><strong>Editorial & Newsletters</strong><em>→</em></a>
    </section>

    <section class="cta shell">
      <h2 class="display">
        Complex ideas deserve <span>better stories.</span>
      </h2>

      <div class="cta__contact">
        <p class="eyebrow">Get in touch</p>

        <div class="cta__links">
          <a href="mailto:ipsitabose.creatrix@gmail.com">
            Email ↗
          </a>

          <a
            href="https://www.linkedin.com/in/ipsitacrtx/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
